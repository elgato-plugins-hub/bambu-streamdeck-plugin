{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
	"Name": "Bambu Connect",
	"Version": "1.0.0.0",
	"Author": "Alejandro Cabo",
	"Description": "Live telemetry monitor for Bambu Lab 3D printers (Nozzle, Bed, Chamber, AMS, Progress, Time, Fans, Gcode).",
	"Category": "Bambu Connect",
	"CategoryIcon": "imgs/plugin/category-icon",
	"Icon": "imgs/plugin/category-icon",
	"CodePath": "bin/plugin.js",
	"SDKVersion": 2,
	"Software": {
		"MinimumVersion": "6.4"
	},
	"OS": [
		{
			"Platform": "mac",
			"MinimumVersion": "10.15"
		},
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Nodejs": {
		"Version": "20"
	},
	"UUID": "com.alejandrocabo.bambuconnect",
	"Actions": [
		{
			"UUID": "com.alejandrocabo.bambuconnect.print-progress",
			"Name": "Print Progress",
			"Tooltip": "Displays current print progress percentage and status ring.",
			"Icon": "imgs/actions/print-status/icon",
			"PropertyInspectorPath": "ui/print-status.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/print-status/icon"
				}
			]
		},
		{
			"UUID": "com.alejandrocabo.bambuconnect.nozzle-temp",
			"Name": "Nozzle Temp",
			"Tooltip": "Displays nozzle current and target temperature.",
			"Icon": "imgs/actions/print-status/icon",
			"PropertyInspectorPath": "ui/print-status.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/print-status/icon"
				}
			]
		},
		{
			"UUID": "com.alejandrocabo.bambuconnect.bed-temp",
			"Name": "Heatbed Temp",
			"Tooltip": "Displays heatbed current and target temperature.",
			"Icon": "imgs/actions/print-status/icon",
			"PropertyInspectorPath": "ui/print-status.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/print-status/icon"
				}
			]
		},
		{
			"UUID": "com.alejandrocabo.bambuconnect.chamber-temp",
			"Name": "Chamber Temp",
			"Tooltip": "Displays internal chamber temperature.",
			"Icon": "imgs/actions/print-status/icon",
			"PropertyInspectorPath": "ui/print-status.html",
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/print-status/icon"
				}
			]
		},
		{
			"UUID": "com.alejandrocabo.bambuconnect.fan-speed",
			"Name": "Air & Fan Speeds",
			"Tooltip": "Displays Part Cooling, Aux Fan, and Chamber Filter Fan speeds.",
			"Icon": "imgs/actions/print-status/icon",
			"PropertyInspectorPath": "ui/print-status.html",
			"Controllers": [
